function Physics.ApplyRightOutsideCurve(self, ball)
    if ball.Owner.Value == LocalPlayer then
        self:AddAngularVelocity(Vector3.new(0, 50, 0), Vector3.new(0, 5000, 0), ball, 0.5)
        local curve = RightOutsideCurve:Clone()
        curve.Parent = ball
        curve:WaitForChild("Script").Disabled = false
        RemoteHandler.BallNetworking():FireServer("NetworkOwnershipAV", {ball, Vector3.new(0, 50, 0), Vector3.new(0, 5000, 0), 0.5})
        RemoteHandler.BallNetworking():FireServer("OutsideCurveR", {ball})
    elseif ball.Owner.Value ~= LocalPlayer and PingStat.Value ~= "MAX_PING" then
        RemoteHandler.BallNetworking():FireServer("NetworkOwnershipAV", {ball, Vector3.new(0, 50, 0), Vector3.new(0, 5000, 0), 0.5})
