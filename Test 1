RemoteHandler.BallNetworking().OnClientEvent:Connect(function(event, data)
    if event == "RemoveForces" then
        for _, child in pairs(data[1]:GetChildren()) do
            if child.Name == "InsideCurveR" or child.Name == "InsideCurveL" or child.Name == "OutsideCurveR" or child.Name == "OutsideCurveL" or child.Name == "Knuckle" or child.Name == "KnuckleL" then
                child:Destroy()
            end
        end
    elseif event == "HitCheck" then
        if data[1].Parent == workspace.Balls and data[1].Hit.Value == false then
            data[1].Hit.Value = true
            wait(0.1)
            if data[1].Parent == workspace.Balls then
                data[1].Hit.Value = false
            end
        end
    elseif event == "AnkleCheck" and data[1].Parent == workspace.Balls and data[1].Hit.Ankle.Value == false then
        data[1].Hit.Ankle.Value = true
        wait(0.3)
        if data[1].Parent == workspace.Balls then
            data[1].Hit.Ankle.Value = false
        end
    end
end)

RemoteHandler.Decline().OnClientInvoke = Physics.ShowDeclineMessage
